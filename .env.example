# ==============================================================================
# EyaminDev Portfolio - Frontend Public Environment Variables
# ==============================================================================
# Security Notice (Rule 6):
# NEVER store private API keys or secrets in .env or with a VITE_ prefix.
# All LLM API keys (e.g., GEMINI_API_KEY) live strictly inside the Cloudflare
# Worker as encrypted secrets via: wrangler secret put GEMINI_API_KEY
# ==============================================================================

# Public URL of the separate Cloudflare Worker (eyamin-agent-api)
VITE_AGENT_API_URL=https://eyamin-agent-api.eyamin.workers.dev

# Public Cloudflare Turnstile Site Key (optional bot challenge)
VITE_TURNSTILE_SITE_KEY=
